{
  "name": "@vakhta/db",
  "version": "0.1.0",
  "private": true,
  "description": "Vakhta PostgreSQL schema, migrations, and database client built with Drizzle.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "generate:custom": "drizzle-kit generate --custom",
    "migrate": "drizzle-kit migrate",
    "seed": "node --env-file-if-exists=../../.env dist/seed.js",
    "studio": "drizzle-kit studio",
    "migrate:js": "node --env-file-if-exists=../../.env dist/migrate.js",
    "migrate:tenants": "node --env-file-if-exists=../../.env dist/migrate-tenants.js"
  },
  "dependencies": {
    "@vakhta/contracts": "workspace:*",
    "@vakhta/domain": "workspace:*",
    "@vakhta/registry": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vakhta/config": "workspace:*",
    "drizzle-kit": "^0.31.0",
    "typescript": "catalog:"
  }
}
