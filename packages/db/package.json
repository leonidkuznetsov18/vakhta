{
  "name": "@vakhta/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle-схема PostgreSQL, міграції і клієнт бази даних Вахти",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "generate:custom": "drizzle-kit generate --custom",
    "migrate": "drizzle-kit migrate",
    "seed": "node --env-file=../../.env dist/seed.js",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@vakhta/domain": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vakhta/config": "workspace:*",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.3"
  }
}
