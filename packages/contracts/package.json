{
  "name": "@vakhta/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas for commands, responses, and events across Vakhta applications.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vakhta/domain": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vakhta/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
