{
  "name": "@vakhta/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Localized messages for the Vakhta bot, admin panel, and kiosk; Russian is the default locale.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vakhta/domain": "workspace:*"
  },
  "devDependencies": {
    "@vakhta/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
