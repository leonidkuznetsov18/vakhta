# Загальне
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL (див. infra/compose/docker-compose.yml)
DATABASE_URL=postgres://vakhta:vakhta@localhost:5432/vakhta

# Redis. Host-порт 6380, бо 6379 часто зайнятий іншим локальним Redis;
# змінюється через VAKHTA_REDIS_PORT у compose.
REDIS_URL=redis://localhost:6380

# S3-сумісне сховище (MinIO локально)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vakhta-media
S3_ACCESS_KEY=vakhta
S3_SECRET_KEY=vakhta-secret
S3_FORCE_PATH_STYLE=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=vakhta_worker_bot
# polling: API сам забирає оновлення, публічна адреса не потрібна (розробка).
# webhook: Telegram шле оновлення на PUBLIC_BASE_URL/telegram/webhook (продакшен).
# Порожньо = polling поза NODE_ENV=production.
TELEGRAM_MODE=polling
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token (лише webhook); згенеруйте: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Базова адреса API: для better-auth і для webhook. Локально http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# API
API_PORT=3000
API_HOST=0.0.0.0
# Origin панелі й терміналу (через кому)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Веб-автентифікація панелі (better-auth): підпис cookie і шифрування TOTP; згенеруйте: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-secret-of-at-least-32-chars

# Активація працівників (ТЗ 2.2). Pepper для HMAC кодів; згенеруйте: openssl rand -hex 32
ACTIVATION_PEPPER=change-me-to-a-long-random-secret-value
ACTIVATION_TTL_HOURS=72
ACTIVATION_MAX_ATTEMPTS=5

# Графік (ТЗ 3.2, 18 п. 4): відпочинок між змінами, ліміти, нагадування
SCHEDULE_MIN_REST_MINUTES=660
SCHEDULE_MAX_HOURS_PER_MONTH=200
SCHEDULE_MAX_CONSECUTIVE_DAYS=4
SHIFT_REMINDER_MINUTES=120
ACK_REMINDER_HOURS=24
# Присутність (ТЗ 18 п. 4): за скільки хвилин до зміни можна відмітити прихід, скільки після кінця відхід
PRESENCE_ARRIVE_BEFORE_MINUTES=180
PRESENCE_DEPART_AFTER_MINUTES=180
# Воркер: як часто опитувати аутбокс нотифікацій
OUTBOX_POLL_MS=1000

# Майданчик за замовчуванням (ТЗ 18, п. 1)
DEFAULT_SITE_TIMEZONE=Europe/Kyiv

# QR-термінал (ТЗ 18, п. 8)
QR_ROTATION_SECONDS=45
QR_TTL_SECONDS=90

# Термінал для локальної розробки: pnpm db:seed реєструє термінал «Проходная» з цим токеном
KIOSK_DEVICE_TOKEN=dev-kiosk-device-token-change-me

# Панель і термінал (Vite читає лише змінні з префіксом VITE_, з кореневого .env)
VITE_API_URL=http://localhost:3000
VITE_KIOSK_DEVICE_TOKEN=dev-kiosk-device-token-change-me
