# Загальне
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL (див. infra/compose/docker-compose.yml)
DATABASE_URL=postgres://vakhta:vakhta@localhost:5432/vakhta

# Redis. Host-порт 6380, бо 6379 часто зайнятий іншим локальним Redis;
# змінюється через VAKHTA_REDIS_PORT у compose.
REDIS_URL=redis://localhost:6380

# S3-сумісне сховище (MinIO локально)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vakhta-media
S3_ACCESS_KEY=vakhta
S3_SECRET_KEY=vakhta-secret
S3_FORCE_PATH_STYLE=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=vakhta_worker_bot
# polling: API сам забирає оновлення, публічна адреса не потрібна (розробка).
# webhook: Telegram шле оновлення на PUBLIC_BASE_URL/telegram/webhook (продакшен).
# Порожньо = polling поза NODE_ENV=production.
TELEGRAM_MODE=polling
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token (лише webhook); згенеруйте: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Базова адреса API: для better-auth і для webhook. Локально http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# API
API_PORT=3000
API_HOST=0.0.0.0
# Origin панелі й терміналу (через кому)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Веб-автентифікація панелі (better-auth): підпис cookie і шифрування TOTP; згенеруйте: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-secret-of-at-least-32-chars

# Активація працівників (ТЗ 2.2). Pepper для HMAC кодів; згенеруйте: openssl rand -hex 32
ACTIVATION_PEPPER=change-me-to-a-long-random-secret-value
ACTIVATION_TTL_HOURS=72
ACTIVATION_MAX_ATTEMPTS=5

# Графік (ТЗ 3.2, 18 п. 4): відпочинок між змінами, ліміти, нагадування
SCHEDULE_MIN_REST_MINUTES=660
SCHEDULE_MAX_HOURS_PER_MONTH=200
SCHEDULE_MAX_CONSECUTIVE_DAYS=4
SHIFT_REMINDER_MINUTES=120
ACK_REMINDER_HOURS=24
# Присутність (ТЗ 18 п. 4): за скільки хвилин до зміни можна відмітити прихід, скільки після кінця відхід
PRESENCE_ARRIVE_BEFORE_MINUTES=180
PRESENCE_DEPART_AFTER_MINUTES=180
# Воркер: як часто опитувати аутбокс нотифікацій
OUTBOX_POLL_MS=1000

# Майданчик за замовчуванням (ТЗ 18, п. 1)
DEFAULT_SITE_TIMEZONE=Europe/Kyiv

# QR-термінал (ТЗ 18, п. 8)
QR_ROTATION_SECONDS=45
QR_TTL_SECONDS=90

# Local-dev terminal: pnpm db:seed registers the terminal "Проходная" already paired with this token
KIOSK_DEVICE_TOKEN=dev-kiosk-device-token-change-me

# Panel and terminal (Vite reads only VITE_-prefixed variables from the root .env)
VITE_API_URL=http://localhost:3000
# Local-dev shortcut only: in production the tablet pairs with a code from the panel and keeps
# its device token in browser storage, nothing is baked into the build.
VITE_KIOSK_DEVICE_TOKEN=dev-kiosk-device-token-change-me
# Kiosk address the panel prints in pairing links (optional).
VITE_KIOSK_URL=http://localhost:5174

# Ліміти тимчасових станів і поріг ескалації простою (ТЗ 18 п. 5, 9)
BREAK_MINUTES=15
MEAL_MINUTES=60
SERVICE_TIME_MINUTES=30
DOWNTIME_ESCALATION_MINUTES=15
# Пільгове вікно запізнення/раннього відходу; вікно раннього старту; поріг переробки (ТЗ 6.1)
SHIFT_GRACE_MINUTES=10
EARLY_START_WINDOW_MINUTES=30
OVERTIME_THRESHOLD_MINUTES=15
# SLA реакції майстра на інцидент і вікно злиття дублів (FR-DWN-03/04)
INCIDENT_SLA_NORMAL_MINUTES=60
INCIDENT_SLA_CRITICAL_MINUTES=30
INCIDENT_SLA_SAFETY_MINUTES=0
INCIDENT_DUPLICATE_WINDOW_MINUTES=60
# Прибирання і передача (FR-CLN-01, ТЗ 18 п. 10–11); пороги фото (FR-PHO-03); посилання на фото (FR-PHO-06)
CLEANING_REMINDER_MINUTES=30
HANDOVER_REVIEW_WINDOW_MINUTES=30
MEDIA_LINK_TTL_SECONDS=300
MEDIA_MIN_WIDTH=640
MEDIA_MIN_HEIGHT=480
MEDIA_MIN_BRIGHTNESS=40
MEDIA_NEAR_DUPLICATE_DISTANCE=6
MEDIA_RETENTION_DAYS=365
# Строк апеляції по балах, робочих днів (ТЗ 7.7)
APPEAL_WINDOW_DAYS=3

# Outgoing mail for activation cards (docs/features/02-activation-and-bot.md). Any SMTP provider:
# Resend (smtps://resend:API_KEY@smtp.resend.com:465), Postmark, Google Workspace, an own relay.
# Without SMTP_URL and MAIL_FROM the "Send by e-mail" button reports that mail is not configured.
SMTP_URL=
MAIL_FROM=
MAIL_REPLY_TO=

# Support assistant bot (docs/features/12-support-bot.md): a second bot that answers questions
# about the system from docs/features, the user guide and the changelog. Optional.
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_SUPPORT_WEBHOOK_SECRET=
SUPPORT_BOT_USERNAME=
# Claude API key for the answers (https://console.anthropic.com); the model name may be changed.
ANTHROPIC_API_KEY=
SUPPORT_MODEL=claude-sonnet-5
# OpenAI key for voice questions and answers; without it the assistant answers in text only.
OPENAI_API_KEY=
# Telegram user ids (comma separated) allowed without an employee link, e.g. administrators.
SUPPORT_ALLOWED_TELEGRAM_IDS=
SUPPORT_RATE_LIMIT_PER_HOUR=40
