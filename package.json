{
  "name": "vakhta",
  "version": "1.34.0",
  "private": true,
  "type": "module",
  "description": "Vakhta Connected Worker platform for shift operations in continuous manufacturing.",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "pnpm test:release && pnpm test:db-scripts && turbo run test",
    "test:release": "node --test scripts/release/*.test.mjs",
    "test:db-scripts": "node --test scripts/db/*.test.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --pass-on-unpruned-suppressions",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/compose/docker-compose.yml down",
    "db:generate": "pnpm --filter @vakhta/db generate",
    "db:migrate": "pnpm --filter @vakhta/db migrate",
    "db:seed": "pnpm --filter @vakhta/db... build && pnpm --filter @vakhta/db seed",
    "db:migrate:js": "pnpm --filter @vakhta/db... build && pnpm --filter @vakhta/db migrate:js",
    "qa:with-secrets": "op run --env-file=.env.e2e --",
    "api:generate": "pnpm --filter api build && node apps/api/scripts/export-employee-openapi.mjs && pnpm --filter admin-web api:generate && prettier --write contracts/openapi/employees.json",
    "api:check": "pnpm api:generate && git diff --exit-code -- contracts/openapi/employees.json apps/admin-web/src/entities/employee/api/generated",
    "test:architecture": "node --test scripts/architecture/*.test.mjs",
    "audit:unused": "knip --no-exit-code",
    "audit:fsd": "steiger apps/admin-web/src"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "catalog:",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.2.0",
    "knip": "6.35.1",
    "prettier": "^3.5.3",
    "railway": "^3.11.0",
    "semantic-release": "^25.0.9",
    "steiger": "0.6.0",
    "turbo": "^2.5.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.33.0"
  }
}
