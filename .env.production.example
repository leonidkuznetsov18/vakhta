# Шаблон продакшен-змінних. Значення задаються в панелі хостингу (Railway/Fly/Render, Vercel),
# файл .env.production у git не потрапляє. Секрети: openssl rand -base64 48

# ---------- API (apps/api) ----------
NODE_ENV=production
LOG_LEVEL=info
API_PORT=3000
API_HOST=0.0.0.0
# Публічна адреса API; має бути https, бо cookie сесії панелі Secure
PUBLIC_BASE_URL=https://api.example.com
# Origin панелі й кіоска через кому; лише https
CORS_ORIGINS=https://panel.example.com,https://kiosk.example.com
# lax: панель і API під одним доменом (panel.example.com + api.example.com), рекомендовано.
# none: різні сайти (vercel.app + railway.app); Safari блокує такі cookie, тому лише для тестів.
AUTH_COOKIE_SAME_SITE=lax

# PostgreSQL 16 (Neon: ?sslmode=require), Redis 7 (Upstash: rediss://)
DATABASE_URL=postgres://user:password@host:5432/vakhta?sslmode=require
REDIS_URL=rediss://default:password@host:6379

# Секрети (обовʼязково замінити; заглушки «change-me» не проходять перевірку при старті)
AUTH_SECRET=
ACTIVATION_PEPPER=
TELEGRAM_WEBHOOK_SECRET=
METRICS_TOKEN=

# Telegram: у продакшені лише webhook
TELEGRAM_BOT_TOKEN=
# Public address of the user guide for the bot's /help (optional)
# USER_GUIDE_URL=https://panel.example.com/user-guide.pdf
TELEGRAM_BOT_USERNAME=vakhta_worker_bot
TELEGRAM_MODE=webhook

# Майданчик і QR (ТЗ 18 п. 1, 8)
DEFAULT_SITE_TIMEZONE=Europe/Kyiv
QR_ROTATION_SECONDS=45
QR_TTL_SECONDS=90

# S3-сумісне сховище фото (Cloudflare R2: S3_REGION=auto, S3_FORCE_PATH_STYLE=true)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=vakhta-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
MEDIA_LINK_TTL_SECONDS=300

# Помилки в Sentry (необовʼязково)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Параметри ТЗ 18 мають дефолти з docs/parameters.md; перевизначайте за потреби:
# SCHEDULE_MIN_REST_MINUTES=660 SCHEDULE_MAX_HOURS_PER_MONTH=200 SCHEDULE_MAX_CONSECUTIVE_DAYS=4
# SHIFT_REMINDER_MINUTES=120 ACK_REMINDER_HOURS=24
# PRESENCE_ARRIVE_BEFORE_MINUTES=180 PRESENCE_DEPART_AFTER_MINUTES=180
# BREAK_MINUTES=15 MEAL_MINUTES=60 SERVICE_TIME_MINUTES=30 DOWNTIME_ESCALATION_MINUTES=15
# SHIFT_GRACE_MINUTES=10 EARLY_START_WINDOW_MINUTES=30 OVERTIME_THRESHOLD_MINUTES=15
# INCIDENT_SLA_NORMAL_MINUTES=60 INCIDENT_SLA_CRITICAL_MINUTES=30 INCIDENT_SLA_SAFETY_MINUTES=0
# INCIDENT_DUPLICATE_WINDOW_MINUTES=60 CLEANING_REMINDER_MINUTES=30 HANDOVER_REVIEW_WINDOW_MINUTES=30
# APPEAL_WINDOW_DAYS=3

# ---------- Worker (apps/worker) ----------
# NODE_ENV, LOG_LEVEL, DATABASE_URL, REDIS_URL, TELEGRAM_BOT_TOKEN, S3_*, SENTRY_DSN ті самі, що в API.
# OUTBOX_POLL_MS=1000 OUTBOX_BATCH=20 OUTBOX_MAX_ATTEMPTS=10
# MEDIA_MIN_WIDTH=640 MEDIA_MIN_HEIGHT=480 MEDIA_MIN_BRIGHTNESS=40 MEDIA_NEAR_DUPLICATE_DISTANCE=6
# MEDIA_RETENTION_DAYS=365

# ---------- Vercel: панель (apps/admin-web) ----------
# VITE_API_URL=https://api.example.com

# ---------- Cloudflare Pages: kiosk (apps/qr-kiosk) ----------
# VITE_API_URL=https://api.example.com
# No device token here: the tablet pairs with a code from "Administration → Terminals" in the panel.
