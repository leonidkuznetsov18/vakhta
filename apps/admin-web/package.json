{
  "name": "admin-web",
  "version": "0.1.0",
  "private": true,
  "description": "Vakhta admin panel for shift operations, scheduling, incidents, handovers, employee requests, bonuses, and reports.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "api:generate": "orval --config orval.config.ts && prettier --write src/entities/employee/api/generated",
    "test:browser": "playwright test"
  },
