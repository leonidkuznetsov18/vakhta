    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-table": "9.2.4",
    "@vakhta/contracts": "workspace:*",
    "@vakhta/domain": "workspace:*",
    "@vakhta/i18n": "workspace:*",
    "axios": "1.20.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "date-fns": "^4.4.0",
