{
  "name": "qr-kiosk",
  "version": "0.1.0",
  "private": true,
  "description": "Vakhta checkpoint kiosk displaying dynamic arrival and departure QR codes.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 5174",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vakhta/contracts": "workspace:*",
    "@vakhta/i18n": "workspace:*",
    "qrcode": "catalog:",
    "@vakhta/tenant-client": "workspace:*"
  },
  "devDependencies": {
    "@types/qrcode": "catalog:",
    "@vakhta/config": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
