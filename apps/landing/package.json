{
  "name": "landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trilingual manufacturing landing page for Vakhta.",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "node scripts/build.mjs && vite preview --host 127.0.0.1 --port 5175 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 5175 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts vite.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@vakhta/i18n": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vakhta/config": "workspace:*",
    "@vitejs/plugin-react": "^5.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
