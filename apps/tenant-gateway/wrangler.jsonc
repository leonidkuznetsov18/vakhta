{
  "name": "vakhta-tenant-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "vars": {
    "PLATFORM_ZONE": "vakhta.xyz",
    "API_ORIGIN": "https://api-production-1f77.up.railway.app",
    "CONTROL_ORIGIN": "https://control-api.vakhta.xyz",
  },
}
