{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API, Telegram webhook і SSE Вахти на NestJS",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api -c blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file=../../.env --watch --watch-preserve-output dist/main.js\"",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "telegram:set-webhook": "node --env-file=../../.env --import tsx scripts/set-webhook.ts",
    "auth:bootstrap": "node --env-file=../../.env --import tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@vakhta/contracts": "workspace:*",
    "@vakhta/db": "workspace:*",
    "@vakhta/domain": "workspace:*",
    "@vakhta/i18n": "workspace:*",
    "better-auth": "^1.7.2",
    "fastify": "^5.3.0",
    "grammy": "^1.36.0",
    "ioredis": "^5.6.1",
    "luxon": "^3.6.1",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.0.0",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.15.0",
    "@vakhta/config": "workspace:*",
    "concurrently": "^9.1.2",
    "otpauth": "^9.5.2",
    "pino-pretty": "^13.0.0",
    "testcontainers": "^11.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
