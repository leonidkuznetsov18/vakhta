{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API, Telegram webhook і SSE Вахти на NestJS",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api -c blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch --watch-preserve-output dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "telegram:set-webhook": "node --env-file-if-exists=../../.env dist/cli/set-webhook.js",
    "auth:bootstrap": "node --env-file-if-exists=../../.env dist/cli/bootstrap-admin.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@fastify/multipart": "^9.4.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@nestjs/swagger": "11.4.7",
    "@sentry/node": "catalog:",
    "@vakhta/contracts": "workspace:*",
    "@vakhta/db": "workspace:*",
    "@vakhta/domain": "workspace:*",
    "@vakhta/i18n": "workspace:*",
    "better-auth": "^1.7.2",
    "csv-stringify": "6.8.3",
    "fastify": "^5.3.0",
    "grammy": "catalog:",
    "ical-generator": "11.1.1",
    "ioredis": "catalog:",
    "luxon": "catalog:",
    "music-metadata": "^11.15.0",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.5.0",
    "pdf-lib": "^1.17.1",
    "pino": "catalog:",
    "pino-http": "10.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "catalog:",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@swc/core": "^1.16.2",
    "@testcontainers/postgresql": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "@vakhta/config": "workspace:*",
    "concurrently": "catalog:",
    "otpauth": "^9.5.2",
    "pino-pretty": "catalog:",
    "testcontainers": "^11.0.0",
    "typescript": "catalog:",
    "unplugin-swc": "^1.5.11",
    "vitest": "catalog:"
  }
}
